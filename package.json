{
  "name": "ewe-and-me",
  "private": true,
  "version": "0.1.0",
  "description": "A cozy pixel-art fiber-farm and yarn-shop game, made for Madhu.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
